# Token bot Discord
TOKEN=

# Web panel của bot — 2 cổng, cùng giao diện, khác quyền:
#  PANEL_PORT (1508)       = SUPER ADMIN: mở cụm ép kết quả bằng #<PANEL_EP_KEY>
#  PANEL_PUBLIC_PORT (3001)= ADMIN THƯỜNG (share link này): ép kết quả khóa cứng,
#                            trần nạp tiền/ngày luôn áp
# Nhớ mở firewall cả 2: ufw allow 1508; ufw allow 3001
PANEL_PORT=1508
PANEL_PUBLIC_PORT=3001
PANEL_PASSWORD=
# Khóa mở cụm điều khiển ép kết quả trên panel (mở panel kèm #<khóa> trên URL)
PANEL_EP_KEY=

# Cổng web CƯỢC cho người chơi (tách hẳn panel admin; đăng nhập bằng PIN bot phát)
PLAY_PORT=3002
# Link hiển thị trong tin nhắn bot khi người chơi bấm nút lấy PIN.
# Có tên miền rồi thì đổi thành https://nghienpal.com — xem GAN-TEN-MIEN.md.
# Nhớ pm2 restart BotDoMin --update-env, thiếu --update-env là pm2 giữ biến cũ.
WEB_PLAY_URL=http://103.72.98.37:3002

# --- Kết nối tới Palworld Admin Dashboard (project palworld-dashboard) ---
# Dashboard phải chạy CÙNG máy với bot. Nó mặc định chỉ nghe 127.0.0.1 nên
# không ai từ internet gọi được — đừng đổi thành 0.0.0.0.
PAL_DASHBOARD_URL=http://127.0.0.1:3000

# Phải khớp DASHBOARD_PASSWORD trong server/.env của palworld-dashboard
PAL_DASHBOARD_PASSWORD=
