# Mẫu .env của BotDoMin (viết lại 06/10 theo các biến code THẬT đang đọc - grep process.env).
# File thật nằm ở /opt/minigame/BotDoMin/.env trên VPS, KHÔNG commit. Bỏ trống = dùng mặc định ghi bên cạnh.

# Token bot Discord (bắt buộc)
TOKEN=

# --- Web ---
# Web người chơi (play.netco4.click -> nginx -> cổng này)
PLAY_PORT=3002
# Link web gửi kèm tin nhắn Discord (mặc định trong code vẫn là IP cũ - nên đặt)
WEB_PLAY_URL=https://play.netco4.click
# Panel admin: PANEL_PORT = cổng SUPER (admin.netco4.click), PANEL_PUBLIC_PORT = cổng mod (mod.netco4.click, chỉ xem)
PANEL_PORT=1508
PANEL_PUBLIC_PORT=1234
# Mật khẩu cổng mod (cổng mod hiện MỞ không mật khẩu - đặt PANEL_MOD_MO=0 để bắt đăng nhập lại)
PANEL_PASSWORD=
# Mật khẩu RIÊNG cổng SUPER
PANEL_SUPER_PASSWORD=
# PANEL_MOD_MO=0

# --- Cầu nối game Thiên Long (cùng VPS) ---
# Gốc chroot game (game ở <TLBB_ROOT>/home/tlbb), file bí mật của panel GM (khoá X-NetCo4-Key, mật khẩu MySQL), bảng mã VISCII
TLBB_ROOT=/opt/tlbb-root
TLBB_SECRETS=/opt/tlbb-deploy/secrets.env
TLBB_VISCII_MAP=/opt/tlbb-repo/tools/viscii-map.json
# Emoji KNB trong tin nhắn Discord (dạng <:ten:id>)
KNB_EMOJI=

# --- Tuỳ chọn (có mặc định trong code) ---
# ITEMICON_DIR=/opt/minigame/itemicon          # tấm icon vật phẩm game (itemicon.js)
# BANGROI_DATA=/var/www/netco4/data.json        # dữ liệu tab Bảng rơi ở panel (/br-data.json)
# DROP_AUDIT=                                   # file nhật ký rơi boss (dropboss.js)
# GN_ANH_FONT=  GN_ANH_FONT_HO=                 # font vẽ ảnh kết quả Ghép Ngọc
# TAIXIU_DIR= SIEUTX_DIR= ROULETTE_DIR= TIENLEN_DIR= POKER_DIR=   # chỗ để các thư mục game cạnh BotDoMin
# POKER_PORT= POKER_DB= POKER_ADMIN= POKER_AFK_GIAY= POKER_GIAY_LAT=   # chỉ cho bản Poker chạy riêng (dev)

# Biến CŨ, code không còn đọc (đừng thêm lại): PAL_DASHBOARD_URL, PAL_DASHBOARD_PASSWORD (Palworld, gỡ 06/10), PANEL_EP_KEY
