# Palworld dedicated server REST API connection
PALWORLD_HOST=127.0.0.1
PALWORLD_PORT=8212
PALWORLD_PROTOCOL=http
PALWORLD_ADMIN_PASSWORD=changeme

# Mat khau vao dashboard. DE TRONG = khong can dang nhap (mac dinh).
DASHBOARD_PASSWORD=

# Port this dashboard server listens on
PORT=3000

# Interface to bind. GIỮ 127.0.0.1 khi chạy trên VPS — nếu đổi thành 0.0.0.0 thì cả
# internet vào được dashboard (chỉ chặn bằng basic auth). Truy cập từ xa nên dùng
# SSH tunnel:  ssh -L 3000:localhost:3000 -p <cong-ssh> root@<ip-vps>
HOST=127.0.0.1

# SFTP connection used to bridge to the GiveGoldCommand UE4SS Lua mod's queue file
SFTP_HOST=your.sftp.host
SFTP_PORT=2222
SFTP_USERNAME=changeme
SFTP_PASSWORD=changeme
SFTP_MOD_PATH=/path/to/server/Pal/Binaries/Win64/ue4ss/Mods/GiveGoldCommand
